sudo apt install libpcap-dev

gcc sniffer.c -o sniffer
gcc sniffer.c -lpcap -o sniffer
sudo ./sniffer wlp4s0

gcc analyzer.c -o analyzer
gcc analyzer.c -lpcap -o analyzer
sudo ./analyzer

iw dev
iw dev wlp4s0 info
sudo nmcli device set wlp4s0 managed no
sudo ip link set wlp4s0 down
sudo iw dev wlp4s0 set type monitor
sudo ip link set wlp4s0 up